# Optional. Copy to .env inside next-generation. Never commit .env.
# Without these three values the app runs in local guided mode, without AI.
OPENAI_API_KEY=
OPENAI_MODEL=
GATEWAY_ACCESS_TOKEN=
# Optional PostgreSQL knowledge database. No soldier records belong here.
DATABASE_URL=
# Defaults to certificate verification; supply your trusted CA through Node if needed.
DATABASE_SSL=true
PORT=43128
